          "name": "Request 5 - Invalid Authorization",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Hệ thống chặn truy cập (Status 403 Forbidden)\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Nội dung phản hồi là chữ Forbidden\", function () {",
                  "    pm.expect(pm.response.text()).to.eql(\"Forbidden\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking/{{bookingid}}",
              "protocol": "https",
              "host": [
                "restful-booker",
                "herokuapp",
                "com"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            }
          }
        },
        {
          "name": "Request 6 - Invalid Authentication",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code vẫn là 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Hệ thống từ chối cấp token (Bad credentials)\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.reason).to.eql(\"Bad credentials\");",
                  "    // Kiểm tra chắc chắn hệ thống không rò rỉ token",
                  "    pm.expect(jsonData).to.not.have.property(\"token\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://restful-booker.herokuapp.com/auth",
              "protocol": "https",
              "host": [
                "restful-booker",
                "herokuapp",
                "com"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"wrongpassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Request 7 - Invalid Input Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Máy chủ không xử lý được dữ liệu thiếu (Status 500)\", function () {",
                  "    pm.response.to.have.status(500);",
                  "});",
                  "pm.test(\"Nội dung báo lỗi Internal Server Error\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"Internal Server Error\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking",
              "protocol": "https",
              "host": [
                "restful-booker",
                "herokuapp",
                "com"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"Hacker\",\n    \"lastname\": \"Test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
